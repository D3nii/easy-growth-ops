{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "easy-growth-ops.jamilglobal.com" }],
      "destination": "https://www.geteasygrowthops.co/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
